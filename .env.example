# Where the command prefix comes from.
#   ENV=LOCAL  use DS_PREFIX below (handy for a test bot next to the real one). It is required
#              in this mode, and the prefix stored in MongoDB is ignored. Slash commands are also
#              turned off (not registered, not answered), so the test bot can't interfere with the real one.
#   anything else, or empty  use the prefix stored in MongoDB (change it with k!config set prefix).
ENV=

# Discord bot token (Developer Portal > your application > Bot > Reset Token)
DS_TOKEN=
DS_PREFIX=
# Optional: lets members log in on the site with Discord and pick a server and game there.
# Developer Portal > your application > OAuth2: the Client Secret, and add WEB_URL with a trailing
# slash (like https://koma-ui.vercel.app/) under Redirects.
DS_SECRET=

# MongoDB connection string
MONGODB_URL=
# Optional, defaults to "koma"
MONGODB_DB_NAME=koma

# Optional: the games' web site (the Koma-UI repo): the mine in the browser, and Pinecraft (which
# is only played there). Set both WEB_URL (the site) and WEB_API_URL (the bot's public https://
# address; Caddy passes it on to WEB_PORT on this machine, 8787 if left out), or neither. Without
# them the mine is played with buttons in Discord, and Pinecraft is off.
# (The older MINE_WEB_URL / MINE_WS_URL / MINE_WEB_PORT still work in their place.)
WEB_URL=
WEB_API_URL=
WEB_PORT=

